              "name": "xax_construct",
              "title": "XAX native construction"
            },
            {
              "_meta": {
                "xax-mcp/schema": "xax-mcp-tools-v2"
              },
              "annotations": {
                "destructiveHint": false,
                "openWorldHint": false,
                "readOnlyHint": false
              },
              "description": "Apply an exact-root XAXEDIT1 typed mutation carrier. Native edit stages a candidate; native verify must succeed before atomic publication. Rejection or decline retains the current root. Record is hexadecimal transport, not source. Generation/read-set extensions remain unsupported.",
              "inputSchema": {
